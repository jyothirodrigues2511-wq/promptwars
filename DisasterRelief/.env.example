# ── LLM / AI Provider ────────────────────────────────────────────────────────
# Choose the backend for text AI (translate, triage, scam, locate, grid parser):
#   gemini  -> requires GEMINI_API_KEY below (best, includes audio + image vision)
#   ollama  -> FREE local models (no key, no account). Run: `ollama serve`, then
#              `ollama pull qwen2.5` (text) and `ollama pull qwen2.5vl` (vision).
#   openai  -> any OpenAI-compatible endpoint (LM Studio, Groq, OpenRouter...)
#   (unset) -> auto: gemini if GEMINI_API_KEY present, otherwise keyless heuristics
LLM_PROVIDER=ollama

# Gemini (only needed when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Ollama (only needed when LLM_PROVIDER=ollama) — default base URL + model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# Generic OpenAI-compatible endpoint (when LLM_PROVIDER=openai)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ── Routing provider selection ───────────────────────────────────────────────
#   google     -> requires GOOGLE_MAPS_API_KEY
#   osrm       -> free OpenSource Routing Machine (no key needed, default)
#   haversine  -> straight-line distance calc only
# When unset, uses "google" if GOOGLE_MAPS_API_KEY is present, otherwise "osrm".
ROUTING_PROVIDER=osrm

# OSRM public demo server (no key). Self-host or point to your own instance here.
OSRM_BASE_URL=https://router.project-osrm.org

# Optional: enables Google Distance Matrix + Directions API for real road routing.
# Leave blank to stay fully free.
GOOGLE_MAPS_API_KEY=