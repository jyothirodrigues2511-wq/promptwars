# Copy this file to `.env` and fill in your own values — OR export them in your
# shell before running. The code reads these straight from the process
# environment (llm.py); a `.env` file is not auto-loaded unless you add a loader.

# --- Google AI (Gemini) ---
# Primary key. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Accepted alternative; a value in either variable is used.
GOOGLE_API_KEY=

# --- Optional tuning ---
# Model id passed to Gemini (default: gemini-2.5-flash).
AI_TEACHER_MODEL=gemini-2.5-flash

# Path to a JSON mock file for fully offline runs without an API key.
# Example: AI_TEACHER_MOCK=mocks/fixture_mock.json
AI_TEACHER_MOCK=